# These are NOT read from a local .env by any workflow — GitHub Actions pulls
# them from repo Settings → Secrets and variables → Actions instead. This file
# is just a single reference for what to provision there (see README.md
# "Setup checklist"), and for running .github/scripts/ensure_linear_issue.py
# locally against real values.

# --- Repo secrets (Settings → Secrets and variables → Actions → Secrets) ---

# claude-review.yml: run `claude setup-token` locally, or use ANTHROPIC_API_KEY instead
CLAUDE_CODE_OAUTH_TOKEN=

# notify-slack-on-merge.yml: Slack app → Incoming Webhooks
SLACK_WEBHOOK_URL=

# prepare-feature-pr.yml: Linear → Settings → API → Create key
LINEAR_API_KEY=

# prepare-feature-pr.yml: fine-grained PAT (Contents:read, Issues:write, Pull requests:write)
# Must NOT be the default GITHUB_TOKEN — PRs opened with it won't retrigger pr-policy.yml.
GH_PAT=

# --- Repo variables (Settings → Secrets and variables → Actions → Variables) ---

# Linear project this repo's issues live in — from the project's "Copy link" (last URL segment)
LINEAR_PROJECT_SLUG=

# Linear project display name — fallback lookup if the slug ever changes
LINEAR_PROJECT_NAME=
